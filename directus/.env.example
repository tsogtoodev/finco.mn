# ---- Directus core ----
KEY=            # random string  (openssl rand -hex 16)
SECRET=         # random string  (openssl rand -hex 32)
ADMIN_EMAIL=admin@finco.design
ADMIN_PASSWORD=
PUBLIC_URL=https://cms.finco.design
TELEMETRY=false

CONTENT_SECURITY_POLICY_DIRECTIVES__FRAME_SRC="'self',https://finco.design"

# ---- Database: PostgreSQL ----
DB_CLIENT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=finco-mn
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ---- Cache: OFF ----
CACHE_ENABLED=true

# ---- File storage: Cloudflare R2 (S3-compatible) ----
STORAGE_LOCATIONS=r2
STORAGE_R2_DRIVER=s3
STORAGE_R2_KEY=              # R2 API token — Access Key ID
STORAGE_R2_SECRET=           # R2 API token — Secret Access Key
STORAGE_R2_BUCKET=finco-cms-media
STORAGE_R2_REGION=auto
STORAGE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_R2_FORCE_PATH_STYLE=true

# ---- CORS: allow the website + CMS origins ----
CORS_ENABLED=true
CORS_ORIGIN=https://finco.design,https://cms.finco.design

# ---- Cloudflare Tunnel ----
CF_TUNNEL_TOKEN=

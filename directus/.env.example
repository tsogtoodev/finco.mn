# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Generate secrets on the VPS:  openssl rand -hex 32

# ---- Directus core ----
KEY=            # random string  (openssl rand -hex 16)
SECRET=         # random string  (openssl rand -hex 32)
ADMIN_EMAIL=admin@finco.design
ADMIN_PASSWORD= # strong password — used only to create the first admin; change it after first login
PUBLIC_URL=https://cms.finco.design
TELEMETRY=false

# Live preview: Directus's CSP must allow iframing the site, or the preview
# pane renders blank. Double quotes required (compose env parsing).
CONTENT_SECURITY_POLICY_DIRECTIVES__FRAME_SRC="'self',https://finco.design"

# ---- Database: SQLite (chosen for the 1 GB box) ----
DB_CLIENT=sqlite3
DB_FILENAME=/directus/database/data.db

# ---- Cache: OFF on purpose ----
# Cloudflare's 60s edge cache is the real caching layer for public traffic.
# A local Directus cache would just burn RAM this box doesn't have.
CACHE_ENABLED=false

# ---- File storage: Cloudflare R2 (S3-compatible) ----
# Directus WRITES originals here. The website READS them via a Cloudflare-fronted
# public bucket hostname (e.g. media.finco.design) — image bytes never flow through this VPS.
STORAGE_LOCATIONS=r2
STORAGE_R2_DRIVER=s3
STORAGE_R2_KEY=              # R2 API token — Access Key ID
STORAGE_R2_SECRET=           # R2 API token — Secret Access Key
STORAGE_R2_BUCKET=finco-cms-media
STORAGE_R2_REGION=auto
STORAGE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_R2_FORCE_PATH_STYLE=true
# Note: R2 ignores S3 ACLs. Leave STORAGE_R2_ACL unset. If uploads ever fail with an
# ACL/permission error, it is almost always a wrong endpoint or bucket, not an ACL issue.

# ---- CORS: allow the website + CMS origins so the admin app and live preview work ----
CORS_ENABLED=true
CORS_ORIGIN=https://finco.design,https://cms.finco.design

# ---- Cloudflare Tunnel ----
CF_TUNNEL_TOKEN=            # from Zero Trust > Networks > Tunnels (token type)

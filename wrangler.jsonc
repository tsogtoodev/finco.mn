{
  // Cloudflare Workers config for direct deploy (NuxtHub v0.10, no NuxtHub Admin).
  // Nuxt's nitro `cloudflare-module` preset (v2.13) emits a Workers-Sites layout:
  // worker entry at .output/server/index.mjs + static files served from a
  // __STATIC_CONTENT KV that wrangler auto-creates from `site.bucket` on deploy.
  // (Workers Sites is "legacy" but still deploys; modern Static Assets needs a
  // newer nitro — revisit on upgrade.)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finco-mn",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "site": {
    "bucket": "./.output/public"
  },
  "observability": {
    "enabled": true
  },

  // Public env (NUXT_PUBLIC_*) — safe to commit: the Firebase web config is
  // public by design and ships to the browser via the SSR payload. nitro reads
  // these from the Worker env at runtime and overrides runtimeConfig.public.
  // SECRET: NUXT_SESSION_PASSWORD is NOT here — set it as a Wrangler secret:
  //   npx wrangler secret put NUXT_SESSION_PASSWORD
  "vars": {
    "NUXT_PUBLIC_SITE_URL": "https://finco.design",
    "NUXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyAPLipthP1LNINpOxdReNXO6OSl-PbTR1E",
    "NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "finco-mn.firebaseapp.com",
    "NUXT_PUBLIC_FIREBASE_PROJECT_ID": "finco-mn",
    "NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "finco-mn.firebasestorage.app",
    "NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "770110256021",
    "NUXT_PUBLIC_FIREBASE_APP_ID": "1:770110256021:web:188ff48afefdd58f163c9c",
    "NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID": "G-4LXMHLLTKR"
  },

  // Raw D1 binding queried by @nuxt/content (content.database.bindingName: 'DB').
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finco-mn",
      "database_id": "7e1a182c-6b21-4c4e-a3bc-3d9f464f6fca"
    }
  ]
}

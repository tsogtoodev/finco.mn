# Copy to .env for local development. Set the same values as Cloudflare
# secrets in production (npx nuxthub deploy / Cloudflare dashboard).

# --- Auth: session sealing (nuxt-auth-utils) ---
# Server-only secret used to seal the session cookie. openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# --- Auth: Firebase identity (client SDK) ---
# Firebase Console > Project settings > Your apps > Web app config.
# These are public by design (safe to ship to the browser).
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Site ---
# Canonical site URL, used by @nuxtjs/seo for sitemap/canonical/og.
NUXT_PUBLIC_SITE_URL=https://finco.mn
